{
  "name": "fundamento",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node src/check.ts && node src/check-cdmx.ts",
    "typecheck": "tsc",
    "ingest": "node scripts/ingest.ts",
    "embed": "node scripts/embed.ts",
    "eval": "node scripts/eval.ts",
    "dev": "wrangler dev --env=\"\" --port 8787",
    "seed:local": "wrangler d1 execute fundamento --local --file data/seed.sql",
    "seed:remote": "wrangler d1 execute fundamento --remote --file data/seed.sql",
    "deploy": "wrangler deploy --env=\"\"",
    "ingest:transito": "CORPUS=transito node scripts/ingest.ts",
    "dev:transito": "wrangler dev --env transito --port 8788 --persist-to .wrangler/state-transito",
    "seed:transito:local": "wrangler d1 execute semaforo --env transito --local --persist-to .wrangler/state-transito --file data/transito/seed.sql",
    "seed:transito:remote": "wrangler d1 execute semaforo --env transito --remote --file data/transito/seed.sql",
    "deploy:transito": "wrangler deploy --env transito"
  },
  "dependencies": {
    "@escape.tech/graphql-armor": "^3.2.0",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@huggingface/transformers": "^4.3.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
