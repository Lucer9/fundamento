{
  "name": "fundamento",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node src/parse.check.ts",
    "typecheck": "tsc",
    "ingest": "node scripts/ingest.ts",
    "embed": "node scripts/embed.ts",
    "eval": "node scripts/eval.ts",
    "dev": "wrangler dev --port 8787",
    "seed:local": "wrangler d1 execute fundamento --local --file data/seed.sql",
    "seed:remote": "wrangler d1 execute fundamento --remote --file data/seed.sql",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@escape.tech/graphql-armor": "^3.2.0",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
